# Public. Canonical origin used for metadata, OG image URLs and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public. E.164 without spaces, e.g. +2547XXXXXXXX. Masked placeholder is rendered when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Server. Optional: demo requests are POSTed here as JSON as well as logged.
DEMO_WEBHOOK_URL=

# Server. Injected by CI at image build; exposed by /api/health.
GIT_SHA=

# Clerk. Publishable key is public and inlined at build time; the secret never reaches the client.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/after-sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/after-sign-in
# Optional: the instance's JWT public key (PEM) enables networkless session verification.
CLERK_JWT_KEY=

# Server. Pooled Neon connection string used by the dashboard, landlord portal and resident
# surface through @ethanel/db. Marketing and marketplace routes never read it.
DATABASE_URL=
