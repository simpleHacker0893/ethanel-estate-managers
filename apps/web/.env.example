# Public. Canonical origin used for metadata, OG image URLs and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public. E.164 without spaces. Defaults to +254722000000 when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=+254722000000

# Server. Optional: demo requests are POSTed here as JSON as well as logged.
DEMO_WEBHOOK_URL=

# Server. Injected by CI at image build; exposed by /api/health.
GIT_SHA=

# Server. Unsplash API access key (https://unsplash.com/developers). Optional: without it every
# scene photo renders as a brand illustration.
UNSPLASH_ACCESS_KEY=

# Server. NVIDIA NIM key (free at https://build.nvidia.com → any model → Get API Key).
# Optional: without it the assistant answers with scripted demo replies.
NVIDIA_API_KEY=
NVIDIA_CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
# Hosted Riva function ids from build.nvidia.com (Parakeet ASR, Magpie TTS). Verify before go-live.
NVIDIA_ASR_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081
NVIDIA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Aria
# Server. "true" forces the scripted assistant even when a key is set.
ASSISTANT_DEMO_MODE=false
