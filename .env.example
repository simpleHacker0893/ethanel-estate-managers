# Root-level example. Each app has its own .env.example with the variables it reads.
# Nothing here is read by any package; it documents the shared names.

# Injected by CI at image build time; exposed by /api/health.
GIT_SHA=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=<your sk_test key>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/after-sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/after-sign-in
DATABASE_URL=<the ethanel_web pooled string above>
NEXT_PUBLIC_SITE_URL=https://<your-vercel-domain>
GIT_SHA=<optional, shown by /api/health>