# Pooled Neon connection string (host contains `-pooler`). Used by the application and the seed.
DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) string for `prisma migrate deploy`. Same as DATABASE_URL on a local Postgres.
DATABASE_URL_UNPOOLED=postgresql://<role>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require
# Only for `pnpm seed:clerk` (creates the demo accounts in Clerk). Never commit a real key.
CLERK_SECRET_KEY=
